flowchart TD
  classDef startNode fill:#28a745,stroke:#1e7e34,stroke-width:2px,color:#fff,font-weight:bold;
  classDef endNode fill:#dc3545,stroke:#bd2130,stroke-width:2px,color:#fff,font-weight:bold;
  classDef recordNode fill:#fff3cd,stroke:#d39e00,stroke-width:2px,color:#856404,font-weight:bold;
  classDef actionNode fill:#f8f9fa,stroke:#495057,stroke-width:1.5px;
  classDef decisionNode fill:#e9ecef,stroke:#343a40,stroke-width:2px;

  subgraph Admin["Admin / Warehouse Keeper"]
    A21((Start)):::startNode --> A22[A22: Admin enters accepted lines into SAP GRPO today]:::actionNode
    A22 --> A23[A23: Admin exports GRPO file from SAP and uploads to App]:::actionNode
  end

  subgraph Server["Node Ingestion Server"]
    A23 --> A24[A24: Server detects header row & maps SAP document no, line, item, qty]:::actionNode
    A24 --> A25{A25: Is SAP document number and line already imported?}:::decisionNode
    A25 -- "Yes" --> A26{A26: Is upload flagged as corrected revision of existing document?}:::decisionNode
    A26 -- "No" --> A27[A27: Reject duplicate line; display document conflict error]:::actionNode
    A26 -- "Yes" --> A28[A28: App appends offsetting reversal of old line before re-import]:::actionNode
    A25 -- "No" --> A29{A29: Line has valid item code in Master Data and valid quantity?}:::decisionNode
    A28 --> A29
    A29 -- "No" --> A30[A30: Quarantine bad line in staging errors; alert Admin]:::actionNode
    A30 --> A31{A31: Admin updates Master Data & re-imports quarantined lines?}:::decisionNode
    A31 -- "Yes" --> A29
    A29 -- "Yes" --> A32[A32: App appends verified GRPO movement to ledger; updates stock]:::actionNode
  end

  subgraph Outcome["Import Outcome"]
    A27 --> A33((End)):::endNode
    A31 -- "No" --> A33
    A32 --> A33
  end
